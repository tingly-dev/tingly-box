{
	servers {
		# HTTP/3 uses UDP on the same public port as HTTPS/TCP.
		protocols h1 h2 h3
		timeouts {
			read_body 30m
			read_header 1m
			write 0
			idle 10m
		}
	}
}

# https:// (port 443) is implied by the bare host — Caddy auto-provisions TLS
# and its automatic HTTPS redirects :80 -> :443
you.domain {
	handle /tingly/* {
		reverse_proxy localhost:12580 {
			# Caddy flushes text/event-stream responses immediately by default.
			# A negative flush_interval would keep the upstream alive after disconnect.
			transport http {
				read_timeout 0
				keepalive 10m
			}
		}
	}

	# mirror for debug or rc version
	handle /mirror/* {
		uri replace /mirror /tingly
		reverse_proxy localhost:12580 {
			transport http {
				read_timeout 0
				keepalive 10m
			}
		}
	}

	handle /hi {
		respond "Hello, privacy!"
	}

	handle {
		respond "Forbidden" 403
	}
}
