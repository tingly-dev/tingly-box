  schema: {"additionalProperties":false,"properties":{"caption":{"description":"Optional description shown with the file","type":"string"},"path":{"description":"Path to the file to publish in this conversation","type":"string"}},"required":["path"],"type":"object"}
  output: {"additionalProperties":false,"properties":{"message_id":{"type":"string"}},"required":["message_id"],"type":"object"}
