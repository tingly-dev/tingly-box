  description: Change the title and description of a GitHub issue, or the title, description and base branch of a PR. One this thread did not open is put to the user first. It cannot close or merge anything, and it cannot change a PR's head branch (GitHub does not allow it: see create_pr).
  schema: {"additionalProperties":false,"properties":{"base":{"description":"New base branch (PR only), for example main once the PR below it in a stack has merged.","type":"string"},"body":{"description":"New description (replaces the old one).","type":"string"},"number":{"description":"Issue or PR number; optional only when this thread has one PR.","type":"integer"},"title":{"description":"New title.","type":"string"}},"type":"object"}
