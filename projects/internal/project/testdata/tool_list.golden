[coordinator] forget
  description: Delete a memory file.
  schema: {"properties":{"file":{"description":"Memory file name, e.g. release-date.md.","type":"string"}},"required":["file"],"type":"object"}
[coordinator] get_thread
  description: Read a thread's status, branch, last report and recent transcript. Entries are cut and the result capped like read_conversation; page back with before, read entries whole with full.
  schema: {"properties":{"before":{"description":"Optional. 8-character id of a transcript entry to read back from.","type":"string"},"full":{"description":"Show each entry up to 4000 characters instead of 300.","type":"boolean"},"limit":{"description":"How many entries, up to 40. Default 15.","type":"integer"},"thread_id":{"description":"Thread id or its 8-character prefix.","type":"string"}},"required":["thread_id"],"type":"object"}
[coordinator] list_shared_files
  description: List a directory in this project's library or memory. Use library or memory as the root path.
  schema: {"properties":{"path":{"description":"Path in the project's library or memory","type":"string"}},"required":["path"],"type":"object"}
[coordinator] list_threads
  description: List the project's threads, including old and archived ones the thread table in your prompt leaves out. Capped like ls output: when too many match, the oldest are hidden and you are told to narrow it.
  schema: {"properties":{"contains":{"description":"Optional. Only threads whose title, task or last report contains this text.","type":"string"},"limit":{"description":"How many threads, up to 40. Default 20.","type":"integer"},"status":{"description":"Optional. Only threads with this status, e.g. working, waiting, ready, resolved.","type":"string"}},"type":"object"}
[coordinator] message_thread
  description: Send a message to an existing thread (follow-up work, an answer to its question). It runs after the thread's current turn.
  schema: {"properties":{"cite":{"description":"Ids (the msg attribute of the user's event) of the user's own messages that approve or decide what you are telling the thread. The system quotes them to the thread word for word; without a citation the thread treats your message as not approved.","items":{"type":"string"},"type":"array"},"message":{"description":"What to tell the thread.","type":"string"},"thread_id":{"description":"Thread id (the 8-character prefix is enough).","type":"string"}},"required":["thread_id","message"],"type":"object"}
[coordinator] no_update
  description: End this turn without posting anything to the user. Use it when a thread update or settings change needs no message. Call it instead of replying with text.
  schema: {"properties":{"reason":{"description":"Optional. Why nothing needs saying.","type":"string"}},"type":"object"}
[coordinator] propose_threads
  description: Propose threads for the user to start, instead of starting them. Use when the user wants to review a plan first.
  schema: {"properties":{"threads":{"items":{"properties":{"base":{"description":"Optional. Existing local branch the thread's branch starts from, and that its work is merged back into. Default: the directory's base branch. Worktree-mode Git directories only. Use it for work that builds on a release or feature branch.","type":"string"},"branch":{"description":"Optional. Name for the thread's new branch; it must not exist yet. Default: generated from the title.","type":"string"},"repo":{"description":"Optional. Full path of a project directory; omitted uses the primary directory, \"none\" uses scratch.","type":"string"},"task":{"description":"Self-contained instructions for the thread: goal, context, acceptance criteria, how to verify.","type":"string"},"title":{"description":"Thread card title: starts with a verb that names the goal, three to six words, no ids or paths (for example \"Fix Safari export button\").","type":"string"}},"required":["title","task"],"type":"object"},"type":"array"}},"required":["threads"],"type":"object"}
[coordinator] read_conversation
  description: Read earlier messages of this conversation that are no longer shown to you: the user's words, your replies and thread reports. Newest first, back from the window you see or from a message id; or search by text. Results are capped like grep output: long messages are cut, and when the result is too big the oldest entries are hidden and you are told how to reach them. Use it when the user refers to something you cannot see; do not ask them to repeat.
  schema: {"properties":{"before":{"description":"Optional. 8-character id of a message (shown in the results) to read back from; default is the oldest message you can see.","type":"string"},"contains":{"description":"Optional. Only messages containing this text (case-insensitive).","type":"string"},"full":{"description":"Show each message up to 4000 characters instead of 600 (fewer fit in one result).","type":"boolean"},"id":{"description":"Optional. Read this one message whole instead (use the id of a cut-short entry).","type":"string"},"limit":{"description":"How many messages, up to 40. Default 20.","type":"integer"}},"type":"object"}
[coordinator] read_shared_file
  description: Read a UTF-8 text file or image in this project's library or memory. Accepts the absolute path shown for an attachment, or a path beginning library/ or memory/.
  schema: {"properties":{"path":{"description":"Path in the project's library or memory","type":"string"}},"required":["path"],"type":"object"}
[coordinator] remember
  description: Save a requirement, decision, pitfall or coordination preference to project memory. Every new thread and coordinator turn sees the memory index. Reuse the topic of an existing file to update it instead of adding a duplicate; one fact per file; skip what the repository already shows.
  schema: {"properties":{"content":{"description":"The note.","type":"string"},"summary":{"description":"One line for the MEMORY.md index.","type":"string"},"topic":{"description":"Short topic; becomes the file name.","type":"string"}},"required":["topic","content","summary"],"type":"object"}
[coordinator] rename_thread
  description: Change a thread's card title when its goal has changed. Does not touch its branch or history. Same title rules as start_thread.
  schema: {"properties":{"thread_id":{"description":"Thread id or its 8-character prefix.","type":"string"},"title":{"description":"New title: starts with a verb that names the goal, three to six words, no ids or paths.","type":"string"}},"required":["thread_id","title"],"type":"object"}
[coordinator] request_decision
  description: Ask the user to pick one option on a card, when a choice changes their goal or a step cannot be undone. Ask once, with two to four options and one recommended; do not repeat the question in text. Keep working on the recommended option while you wait, unless that step cannot be undone.
  schema: {"properties":{"context":{"description":"Background the user needs to choose. Optional.","type":"string"},"options":{"items":{"properties":{"consequence":{"description":"What happens if chosen, one sentence.","type":"string"},"label":{"description":"The option, a few words.","type":"string"}},"required":["label"],"type":"object"},"maxItems":4,"minItems":2,"type":"array"},"question":{"description":"The question, verb first, in about twelve words.","type":"string"},"reason":{"description":"Why you recommend it, one sentence.","type":"string"},"recommended":{"description":"Index of the recommended option, from 0.","type":"integer"}},"required":["question","options","recommended"],"type":"object"}
[coordinator] resolve_thread
  description: Mark a thread resolved (done). Only when the user says so or its work is merged.
  schema: {"properties":{"thread_id":{"description":"Thread id or prefix.","type":"string"}},"required":["thread_id"],"type":"object"}
[coordinator] send_file
  description: Publish a file to this conversation so the user can see it. <guidance>
  schema: {"properties":{"caption":{"description":"Optional description shown with the file","type":"string"},"path":{"description":"Path to the file to publish in this conversation","type":"string"}},"required":["path"],"type":"object"}
[coordinator] start_thread
  description: Start a new thread (a Claude Code session) for one task, using the selected directory's workspace mode.
  schema: {"properties":{"base":{"description":"Optional. Existing local branch the thread's branch starts from, and that its work is merged back into. Default: the directory's base branch. Worktree-mode Git directories only. Use it for work that builds on a release or feature branch.","type":"string"},"branch":{"description":"Optional. Name for the thread's new branch; it must not exist yet. Default: generated from the title.","type":"string"},"repo":{"description":"Optional. Full path of a project directory; omitted uses the primary directory, \"none\" uses scratch.","type":"string"},"task":{"description":"Self-contained instructions for the thread: goal, context, acceptance criteria, how to verify.","type":"string"},"title":{"description":"Thread card title: starts with a verb that names the goal, three to six words, no ids or paths (for example \"Fix Safari export button\").","type":"string"}},"required":["title","task"],"type":"object"}
[coordinator] update_instructions
  description: Replace the project instructions (only when the user asks).
  schema: {"properties":{"instructions":{"description":"The full new instructions (max 16000 characters).","type":"string"}},"required":["instructions"],"type":"object"}
[worker] send_file
  description: Publish a file to this conversation so the user can see it. <guidance>
  schema: {"properties":{"caption":{"description":"Optional description shown with the file","type":"string"},"path":{"description":"Path to the file to publish in this conversation","type":"string"}},"required":["path"],"type":"object"}
[folder] send_file
  description: Publish a file to this conversation so the user can see it. <guidance>
  schema: {"properties":{"caption":{"description":"Optional description shown with the file","type":"string"},"path":{"description":"Path to the file to publish in this conversation","type":"string"}},"required":["path"],"type":"object"}
