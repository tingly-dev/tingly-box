{
  "name": "tingly-box",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "vite --mode development --port 9245",
    "dev:mock": "vite --mode mock",
    "dev:real": "vite --mode production",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production && node scripts/precompress.mjs dist",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../openapi.json -o ./src/client/schema.d.ts",
    "lint": "oxlint src packages && node scripts/check-style-literals.mjs",
    "lint:fix": "oxlint src packages --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/x-markdown": "^2.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@mui/material": "^9.5.0",
    "@tabler/icons-react": "^3.49.0",
    "@tingly/mannequin": "workspace:*",
    "@tingly/projects": "workspace:*",
    "@tingly/ui": "workspace:*",
    "@tingly/vision": "workspace:*",
    "date-fns": "^4.4.0",
    "devicons-react": "^1.5.0",
    "i18next": "^26.4.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "openai": "^7.32.0",
    "openapi-fetch": "^0.17.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@mui/icons-material": "^9.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "d3-array": "^3.2.4",
    "d3-contour": "^4.0.2"
  },
  "optionalDependencies": {
    "@wailsio/runtime": "3.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
