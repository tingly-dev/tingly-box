{
  "name": "tingly-box",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "vite --mode development --port 9245",
    "dev:mock": "vite --mode mock",
    "dev:real": "vite --mode production",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../openapi.json -o ./src/client/schema.d.ts",
    "lint": "oxlint src packages",
    "lint:fix": "oxlint src packages --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/x-markdown": "^2.9.0",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.15.0",
    "@tabler/icons-react": "^3.49.0",
    "@tingly/mannequin": "workspace:*",
    "@tingly/ui": "workspace:*",
    "@tingly/vision": "workspace:*",
    "date-fns": "^4.4.0",
    "devicons-react": "^1.5.0",
    "i18next": "^26.4.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "openai": "^7.32.0",
    "openapi-fetch": "^0.17.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "react-transition-group": "^4.4.5",
    "recharts": "^3.10.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mui/icons-material": "^9.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.87.0",
