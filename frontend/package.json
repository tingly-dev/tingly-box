    "typescript-eslint": "^8.71.1",
    "vite": "8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "d3-array": "^3.2.4",
    "d3-contour": "^4.0.2"
  },
  "optionalDependencies": {
    "@wailsio/runtime": "3.0.0-beta.26"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
