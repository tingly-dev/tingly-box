{
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off",
    "restriction": "off",
    "pedantic": "off"
  },
  "plugins": ["react"],
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "build/**",
    "*.config.js",
    "*.config.ts"
  ],
  "rules": {
    "react-in-jsx-scope": "off",
    "jsx-key": "off",
    "no-shadow": "off",
    "no-unused-vars": "off",
    "exhaustive-deps": "off",
    "jsx-no-constructed-context-values": "off",
    "no-array-index-key": "off",
    "no-await-in-loop": "off",
    "no-unmodified-loop-condition": "off",
    "no-useless-escape": "off"
  },
  "overrides": [
    {
      "files": ["src/services/api.ts", "src/client/**/*"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": [
        "src/components/**/*",
        "src/hooks/**/*",
        "src/utils/**/*",
        "src/services/**/*",
        "src/contexts/**/*",
        "src/constants/**/*",
        "src/types/**/*",
        "src/styles/**/*",
        "src/features/**/*",
        "src/layout/**/*",
        "src/shell/**/*"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/pages", "@/pages/**", "**/pages/**"],
                "message": "Shared code must not import from pages/. Put what several screens (or the nav) need in src/features/<area>/ and import it from there."
              }
            ]
          }
        ]
      }
    }
  ]
}
